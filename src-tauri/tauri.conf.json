{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Embedded Learning Space",
  "version": "1.0.0",
  "identifier": "com.embeddedc.learning.space",
  "build": {
    "beforeDevCommand": "npm run build:roadmap",
    "beforeBuildCommand": "npm run build:roadmap",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Embedded C Learning Space",
        "width": 1440,
        "height": 920,
        "minWidth": 1050,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self'; img-src 'self' data: blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
