{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Embedded Learning Space",
  "version": "1.0.0",
  "identifier": "com.embeddedc.learning.space",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Embedded C Learning Space",
        "width": 1440,
        "height": 920,
        "minWidth": 1050,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
